{
  "AppSettings": {
    "HomeDrivePath": "C:\\DevelopmentEnvironments\\VideoDownloaderApi\\H-Drive\\",
    "ChannelHostName": "rabbitmq",
    "ChannelPortNumber": 5672,
    "QueueRequestDownload": "ms_vd_q_downloadRequest",
    "WaitForYtdlpToFinishRetryMaxCount": 3,
    "WaitForYtdlpToFinishRetryWait": 5000,
    "MaxFilepathLength": 256,
    "RetryOnErroredMaxCount": 3,
    "ExtractInfoFormatTimeoutMs": 3000,
    "StartupDbRetryCount": 10
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Grpc": "Debug"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "EndpointDefaults": {
      "Protocols": "Http1AndHttp2"
    }
  },
  "ConnectionStrings": {
    "DownloadsDb": "User ID=postgres;Password=postgres;Server=localhost;Port=5433;Database=MS.VdDownloader;Pooling=true;"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information"
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "Path": "C:\\Users\\mk0410\\Desktop\\MS.VD\\MS.VD.Manager\\Logs\\ManagerApi_Log-.json",
          "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog",
          "rollingInterval": "Day",
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}]"
        }
      }
    ]
  }
}