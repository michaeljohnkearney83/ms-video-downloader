# Machine-specific values (your share folder, ports) go in .env.dev.local, which is git-ignored and read after this
# file: docker compose --env-file .env.dev --env-file .env.dev.local ... (see .env.dev.local.example).
HOME_DRIVE_PATH="//c/DevelopmentEnvironments/VideoDownloaderApi/H-Drive/MS.VD.Distributor:/opt/venv/etc/vd_downloader/app/h-drive"
# Manager's default download folder (AppSettings:HomeDrivePath) when a request leaves the folder empty. Forward
# slashes, because compose decodes backslash escapes in .env values (a backslash before v in a path becomes a tab).
MANAGER_HOME_DRIVE_PATH=C:/DevelopmentEnvironments/VideoDownloaderApi/H-Drive/
# Host port for Postgres.
POSTGRES_HOST_PORT=5433
IS_DEBUG_MODE=True
QUEUE_REQUEST_DOWNLOAD="ms_vd_q_downloadRequest"
QUEUE_DOWNLOAD_UPDATE="ms_vd_q_downloadUpdate"
CHANNEL_HOST="rabbitmq"
CHANNEL_PORT_NUMBER=5672
DEFAULT_DOWNLOAD_EXT="mp4"
DEFAULT_RETRY_COUNT=10
DEFAULT_TIMEOUT_SECONDS=30
DEFAULT_DOWNLOAD_STALLED_TIMEOUT_SECONDS=300