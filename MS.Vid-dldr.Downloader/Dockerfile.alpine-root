# Building Stage
FROM python:3.12.5-alpine3.20 AS builder
# Working directory
WORKDIR /app

# Avoid writing .pyc files and ensure unbuffered stdout/stderr
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# Copy the requirements file
COPY requirements.txt .

# Exact yt-dlp release to install (scripts/Update-Ytdlp.ps1 passes the latest from PyPI). Empty = whatever
# requirements.txt resolves to. A new value invalidates this layer, so a plain rebuild picks it up.
ARG YTDLP_VERSION=

# Update package index, install build dependencies, and install Python packages
# Using set -eux for better error handling
RUN set -eux && \
    apk update && \
    apk add --no-cache gcc musl-dev libffi-dev && \
    pip3 install --no-cache-dir --target=packages -r requirements.txt && \
    if [ -n "${YTDLP_VERSION}" ]; then pip3 install --no-cache-dir --target=packages --upgrade "yt-dlp[default]==${YTDLP_VERSION}"; fi


# Final Stage/Image
FROM python:3.12.5-alpine3.20 AS final
# Unbuffered output in the running image too, so `docker logs` shows lines as they happen (it was only set in
# the build stage, and print() from the worker threads only appeared when the buffer filled).
ENV PYTHONUNBUFFERED=1
# Working directory
WORKDIR /app

# Copy the Python packages from the builder stage
COPY --from=builder /app/packages /usr/lib/python3.12/site-packages
# Copy the application files into the container
COPY app/. .
# Set the Python path
ENV PYTHONPATH=/usr/lib/python3.12/site-packages

ENTRYPOINT ["python", "main.py"]