# Building Stage used Ubuntu Chiseled
FROM mcr.microsoft.com/dotnet/sdk:11.0 AS build
WORKDIR /app

# copy csproj and restore as distinct layers
COPY *.csproj .
RUN dotnet restore MS.Vid-dldr.DownloadUpdater.csproj

# copy and publish app and libraries
COPY . .
RUN dotnet publish MS.Vid-dldr.DownloadUpdater.csproj -c Release -o out

# Final Stage/Image
FROM mcr.microsoft.com/dotnet/aspnet:11.0 AS final

# Working directory
WORKDIR /app

# Copy the application from the build stage
COPY --from=build /app/out .

# The .NET 8+ images already have a non-root 'app' user
RUN \
    chown -R app:app /app

# Switch to the new user
USER app

ENTRYPOINT ["dotnet", "MS.Vid-dldr.DownloadUpdater.dll"]