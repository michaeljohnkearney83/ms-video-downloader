# Building Stage using Alpine by default
FROM mcr.microsoft.com/dotnet/sdk:11.0-alpine AS build
WORKDIR /app

# Copy csproj and restore as distinct layers
COPY *.csproj .
# Install required dependencies for gRPC tools
RUN apk add --no-cache \
    libc6-compat \
    protobuf && \
    dotnet restore MS.Vid-dldr.DownloadUpdater.csproj

# Copy and publish app and libraries
COPY . .
RUN dotnet publish MS.Vid-dldr.DownloadUpdater.csproj -c Release -o out

# Final Stage/Image using Alpine Runtime
FROM mcr.microsoft.com/dotnet/aspnet:11.0-alpine AS final
WORKDIR /app

# Create a non-root user and group and change ownership of the app directory to the new user
RUN addgroup -S app && adduser -S app -G app && \
    chown -R app:app /app

# Switch to the new user
USER app

# Copy the application from the build stage
COPY --from=build /app/out .

ENTRYPOINT ["dotnet", "MS.Vid-dldr.DownloadUpdater.dll"]