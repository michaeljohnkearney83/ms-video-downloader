HOME_DRIVE_PATH="/mnt/vd/h-drive:/app/h-drive"
IS_DEBUG_MODE=False
QUEUE_REQUEST_DOWNLOAD=ms_vd_q_downloadRequest
QUEUE_DOWNLOAD_UPDATE=ms_vd_q_downloadUpdate
