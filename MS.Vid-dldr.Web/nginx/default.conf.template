# ${MANAGER_URL} and ${NGINX_RESOLVER} are filled in from the environment when the container starts.
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;

    # Docker's DNS. Resolving per request lets nginx start before the Manager is up.
    resolver ${NGINX_RESOLVER} valid=10s ipv6=off;

    location /v1/ {
        set $manager ${MANAGER_URL};
        proxy_pass $manager;
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # The Manager's health report (/health/live, /health/ready), read by the app's status badge.
    location /health/ {
        set $manager ${MANAGER_URL};
        proxy_pass $manager;
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_read_timeout 10s;
    }

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Hashed build assets never change.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location / {
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
