{
    "BuildType": "DEBUG",
    "ManagerApiAddressGrpc": "http://localhost:5000",
    "ManagerApiRestConfig": {
        "BaseUrl": "http://localhost:8000",
        "Timeout": 24
    },
    "YtdlpGitUrl": "https://github.com/yt-dlp/yt-dlp",
    "QuerySelectorString": "span.css-truncate.css-truncate-target.text-bold.mr-2",
    "StringReplaceFoundVersion": "yt-dlp ",
    "PollInterval": 30000,
    "ManagerApiEndpointUpdateVersion": "/v1/ytdlp/version/{version}"
}