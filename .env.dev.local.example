# Copy to .env.dev.local (git-ignored) and set your own values. Compose reads it after .env.dev:
#   docker compose --env-file .env.dev --env-file .env.dev.local -f docker-compose.Dev.yaml up -d --wait
#
# Share folder the Downloader writes finished files to (host path : container path). Must match the Distributor's
# DownloaderShareFilePath (MS.Vid-dldr.Distributor/appsettings.Local.json).
HOME_DRIVE_PATH="//c/Users/<you>/Videos/vd/MS.VD.Distributor:/opt/venv/etc/vd_downloader/app/h-drive"
# Default download folder when a request leaves the folder empty (+ deployment number). Must exist, or the
# Distributor deletes the file.
MANAGER_HOME_DRIVE_PATH=C:/Users/<you>/Videos/vd/
# Postgres host port, if 5433 is taken.
POSTGRES_HOST_PORT=5433
